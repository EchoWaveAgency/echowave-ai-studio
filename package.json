{
  "name": "echowave-ecosystem",
  "version": "0.1.0",
  "description": "ECHOWAVE Ecosystem - Business Management & AI System",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "floot dev",
    "build": "floot build",
    "start": "floot start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:rollback": "tsx scripts/db/rollback.ts",
    "db:seed": "tsx scripts/db/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.0",
    "pino": "^8.16.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.52.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0",
    "vitest": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "tsx": "^4.0.0",
    "playwright": "^1.40.0",
    "@playwright/test": "^1.40.0"
  }
}
