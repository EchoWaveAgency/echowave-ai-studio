# Database
DATABASE_URL=postgresql://user:password@localhost:5432/echowave
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000

# Authentication (Floot)
FLOOT_AUTH_SECRET=your_floot_auth_secret_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=24h

# Floot Storage
FLOOT_STORAGE_BUCKET=echowave-storage
FLOOT_STORAGE_REGION=us-east-1

# Logging
LOG_LEVEL=info
NODE_ENV=development

# API
NEXT_PUBLIC_API_URL=http://localhost:3000
API_PORT=3000

# Communications (Placeholder - disabled in Phase 0 test mode)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_KEY=
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# AI/Claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe (for future payment integration)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Feature Flags
FEATURE_FLAGS=auth:enabled,design-system:enabled,audit-logging:enabled

# Encryption
ENCRYPTION_KEY=your_encryption_key_here
